<Window x:Class="Orvian.Browser.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwort prüfen" Width="420" Height="210" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Passwort-Leak prüfen" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Das vollständige Passwort wird nicht an den Prüfdienst gesendet." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
        <PasswordBox x:Name="PasswordBox" Height="36" Padding="8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Prüfen" Width="90" Click="Check_Click"/>
        </StackPanel>
    </StackPanel>
</Window>