<Window x:Class="Orvian.Browser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Einstellungen" Width="980" Height="700" MinWidth="820" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <StackPanel Margin="8,6,8,22">
                    <TextBlock Text="ORVIAN" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Einstellungen" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Allgemein" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="General_Click"/>
                <Button Content="Darstellung" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="Appearance_Click"/>
                <Button Content="Datenschutz &amp; Blocker" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="PrivacySettings_Click"/>
                <Button Content="Sicherheit" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="Security_Click"/>
                <Button Content="Leistung" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="Performance_Click"/>
                <Button Content="Wie du den Browser nutzt" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="Help_Click"/>
                <Button Content="Über Orvian" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Click="About_Click"/>
                <Border Margin="8,28,8,0" Padding="12" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">
                    <TextBlock Text="Änderungen werden lokal für dieses Gerät gespeichert." TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="Allgemein" FontSize="30" FontWeight="Bold"/>
                    <TextBlock x:Name="SectionSubtitle" Text="Die wichtigsten Orvian-Einstellungen." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,24"/>

                    <StackPanel x:Name="GeneralPanel">
                        <Border Padding="18" Background="#F8FAFD" CornerRadius="16" Margin="0,0,0,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Startseite" FontWeight="SemiBold"/><TextBlock Text="Beim Start die gewählte Startseite öffnen" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                                <TextBox Grid.Column="1" Width="260" Text="https://www.google.com/" Padding="10,7"/>
                            </Grid>
                        </Border>
                        <Border Padding="18" Background="#F8FAFD" CornerRadius="16" Margin="0,0,0,12">
                            <StackPanel><TextBlock Text="Suchmaschine" FontWeight="SemiBold"/><ComboBox SelectedIndex="0" Margin="0,9,0,0" Height="36"><ComboBoxItem>Google</ComboBoxItem><ComboBoxItem>DuckDuckGo</ComboBoxItem><ComboBoxItem>Bing</ComboBoxItem><ComboBoxItem>Brave Search</ComboBoxItem></ComboBox></StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <Border Padding="18" Background="#F8FAFD" CornerRadius="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Erscheinungsbild" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="Orvian verwendet standardmäßig ein helles Design." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                                <ComboBox SelectedIndex="0" Height="36"><ComboBoxItem>Hell</ComboBoxItem><ComboBoxItem>Dunkel</ComboBoxItem><ComboBoxItem>System</ComboBoxItem></ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Padding="18" Background="#F8FAFD" CornerRadius="16"><StackPanel><TextBlock Text="Animationen" FontWeight="SemiBold"/><CheckBox Content="Flüssige UI-Animationen aktiv" IsChecked="True" Margin="0,10,0,0"/><CheckBox Content="Sanfte Tab-Wechsel aktiv" IsChecked="True" Margin="0,8,0,0"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="Schutzfunktionen" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="Werbeblocker" IsChecked="True" Margin="0,8"/><CheckBox Content="Tracker-Blocker" IsChecked="True" Margin="0,8"/><CheckBox Content="Phishing-Schutz" IsChecked="True" Margin="0,8"/><CheckBox Content="Sichere Navigation" IsChecked="True" Margin="0,8"/><CheckBox Content="Keine Orvian-Telemetrie" IsChecked="True" Margin="0,8"/>
                    </StackPanel>

                    <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                        <Border Padding="18" Background="#F8FAFD" CornerRadius="16"><StackPanel><TextBlock Text="Passwortmanager" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Gespeicherte Zugangsdaten werden lokal verschlüsselt." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14"/><Button Style="{StaticResource PrimaryButton}" Content="Passwort-Tresor öffnen" HorizontalAlignment="Left"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                        <TextBlock Text="Leistung" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="Unbenutzte Tabs automatisch pausieren" IsChecked="True" Margin="0,8"/><CheckBox Content="Cache intelligent verwalten" IsChecked="True" Margin="0,8"/><CheckBox Content="Hardwarebeschleunigung verwenden" IsChecked="True" Margin="0,8"/>
                    </StackPanel>

                    <StackPanel x:Name="HelpPanel" Visibility="Collapsed">
                        <TextBlock Text="Tastaturkürzel" FontSize="17" FontWeight="SemiBold"/>
                        <Border Background="#F8FAFD" CornerRadius="16" Padding="18" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + T" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Neuen Tab öffnen"/>
                                <TextBlock Grid.Row="1" Text="Ctrl + W" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Grid.Column="1" Grid.Row="1" Text="Tab schließen" Margin="0,9,0,0"/>
                                <TextBlock Grid.Row="2" Text="Ctrl + L" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Grid.Column="1" Grid.Row="2" Text="Adressleiste fokussieren" Margin="0,9,0,0"/>
                                <TextBlock Grid.Row="3" Text="Ctrl + R" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Grid.Column="1" Grid.Row="3" Text="Aktuelle Seite neu laden" Margin="0,9,0,0"/>
                                <TextBlock Grid.Row="4" Text="Ctrl + F" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Grid.Column="1" Grid.Row="4" Text="Auf Seite suchen" Margin="0,9,0,0"/>
                                <TextBlock Grid.Row="5" Text="Alt + C" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Grid.Column="1" Grid.Row="5" Text="Browser sperren" FontWeight="Bold" Margin="0,9,0,0"/>
                                <TextBlock Grid.Row="6" Text="Alt + D" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Grid.Column="1" Grid.Row="6" Text="Browser entsperren" FontWeight="Bold" Margin="0,9,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <TextBlock Text="Orvian Browser" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Open Source Browser • Windows x64" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
                        <TextBlock Text="Orvian wird mit WebView2 betrieben und legt großen Wert auf Geschwindigkeit, Privatsphäre und eine moderne Oberfläche." TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>