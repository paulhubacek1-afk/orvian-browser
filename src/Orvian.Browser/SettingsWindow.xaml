<Window x:Class="Orvian.Browser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Einstellungen" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="12" Effect="{StaticResource CardShadow}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,8,10,18"><TextBlock Text="ORVIAN" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Einstellungen" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                <StackPanel>
                    <Button Content="⌂   Allgemein" HorizontalContentAlignment="Left" Padding="14,12" Click="General_Click"/>
                    <Button Content="✦   Darstellung" HorizontalContentAlignment="Left" Padding="14,12" Click="Appearance_Click"/>
                    <Button Content="🛡   Datenschutz" HorizontalContentAlignment="Left" Padding="14,12" Click="PrivacySettings_Click"/>
                    <Button Content="🔐   Sicherheit" HorizontalContentAlignment="Left" Padding="14,12" Click="Security_Click"/>
                    <Button Content="⚡   Leistung" HorizontalContentAlignment="Left" Padding="14,12" Click="Performance_Click"/>
                    <Button Content="⌨   Tastatur &amp; Hilfe" HorizontalContentAlignment="Left" Padding="14,12" Click="Help_Click"/>
                    <Button Content="ⓘ   Über Orvian" HorizontalContentAlignment="Left" Padding="14,12" Click="About_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="8,20,8,8" Padding="13" Background="{StaticResource AccentSoftBrush}" CornerRadius="15"><TextBlock Text="Änderungen gelten lokal auf diesem Gerät. Orvian sendet keine Browser-Telemetrie." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/></Border>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="16,0,0,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="SectionTitle" Text="Allgemein" FontSize="31" FontWeight="Bold"/>
                <TextBlock x:Name="SectionSubtitle" Text="Startseite und grundlegende Browseroptionen." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,24"/>

                <StackPanel x:Name="GeneralPanel">
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17" Margin="0,0,0,13"><StackPanel><TextBlock Text="Startseite" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Öffnet beim Start standardmäßig einen neuen Orvian-Tab." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/><TextBox Text="orvian://newtab" Height="40" Padding="11"/></StackPanel></Border>
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17"><StackPanel><TextBlock Text="Suchmaschine" FontSize="16" FontWeight="SemiBold"/><ComboBox Height="40" Margin="0,10,0,0" SelectedIndex="0"><ComboBoxItem>Google</ComboBoxItem><ComboBoxItem>DuckDuckGo</ComboBoxItem><ComboBoxItem>Bing</ComboBoxItem><ComboBoxItem>Brave Search</ComboBoxItem></ComboBox></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17" Margin="0,0,0,13"><StackPanel><TextBlock Text="Design" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Hell, dunkel oder automatisch mit Windows." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/><ComboBox Height="40" SelectedIndex="2"><ComboBoxItem>Hell</ComboBoxItem><ComboBoxItem>Dunkel</ComboBoxItem><ComboBoxItem>System</ComboBoxItem></ComboBox></StackPanel></Border>
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17"><StackPanel><TextBlock Text="Animationen" FontSize="16" FontWeight="SemiBold"/><CheckBox Content="Flüssige UI-Animationen" IsChecked="True" Margin="0,12,0,0"/><CheckBox Content="Panda-Micro-Animationen" IsChecked="True" Margin="0,9,0,0"/></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17"><StackPanel><TextBlock Text="Schutz" FontSize="16" FontWeight="SemiBold"/><CheckBox Content="Werbeblocker" IsChecked="True" Margin="0,12,0,0"/><CheckBox Content="Tracker-Schutz" IsChecked="True" Margin="0,9,0,0"/><CheckBox Content="Lokale Filter aktualisieren" IsChecked="True" Margin="0,9,0,0"/><TextBlock Text="Der schnelle Blocker nutzt hostname-basierte Sets statt einer langen linearen Suche pro Netzwerkrequest." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                    <Border Padding="22" Background="#F7F9FC" CornerRadius="17"><StackPanel><TextBlock Text="Passwort-Tresor" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Mehrere Logins speichern, anzeigen und löschen. Der Tresor wird mit Windows DPAPI für den aktuellen Benutzer verschlüsselt." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/><Button Content="🔐 Passwort-Tresor öffnen" Height="43" HorizontalAlignment="Left" Padding="16,9" Style="{StaticResource PrimaryButton}" Click="OpenVault_Click"/></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17"><StackPanel><TextBlock Text="Leistung" FontSize="16" FontWeight="SemiBold"/><CheckBox Content="Hardwarebeschleunigung verwenden" IsChecked="True" Margin="0,12,0,0"/><CheckBox Content="Intelligentes Cache-Verhalten" IsChecked="True" Margin="0,9,0,0"/><CheckBox Content="Inaktive Tabs nach Möglichkeit entlasten" IsChecked="True" Margin="0,9,0,0"/></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="HelpPanel" Visibility="Collapsed">
                    <Border Padding="20" Background="#F7F9FC" CornerRadius="17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ctrl + T" FontWeight="SemiBold" Margin="0,0,0,11"/><TextBlock Text="Ctrl + W" FontWeight="SemiBold" Margin="0,0,0,11"/><TextBlock Text="Ctrl + L" FontWeight="SemiBold" Margin="0,0,0,11"/><TextBlock Text="Ctrl + K" FontWeight="SemiBold" Margin="0,0,0,11"/><TextBlock Text="Alt + C / D" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Neuen Tab öffnen" Margin="0,0,0,11"/><TextBlock Text="Aktiven Tab schließen" Margin="0,0,0,11"/><TextBlock Text="Adressleiste fokussieren" Margin="0,0,0,11"/><TextBlock Text="Command Palette" Margin="0,0,0,11"/><TextBlock Text="Browser sperren / entsperren"/></StackPanel></Grid></Border>
                </StackPanel>

                <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                    <Border Padding="24" Background="#F7F9FC" CornerRadius="17"><StackPanel><TextBlock Text="Orvian Browser" FontSize="29" FontWeight="Bold"/><TextBlock Text="Stable 0.3.0 • Windows x64" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,16"/><TextBlock Text="Orvian kombiniert WebView2, einen schnellen Netzwerk-Blocker, echte Tabs, einen lokalen Passwort-Tresor und den Panda als lebendige Browserbegleitung." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                </StackPanel>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</Window>
