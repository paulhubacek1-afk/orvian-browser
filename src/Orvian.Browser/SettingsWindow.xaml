<Window x:Class="Orvian.Browser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Einstellungen" Width="1060" Height="720" MinWidth="900" MinHeight="580"
        Background="#F3F6FB" Foreground="#172033" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#506078"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EDF3FC"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#E1EBFB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="BorderBrush" Value="#DDE5F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="4,0,4,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Width="44" Height="44" CornerRadius="14" Background="#2F6BFF" VerticalAlignment="Center">
                    <TextBlock Text="O" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="ORVIAN" FontWeight="Bold" FontSize="17" Foreground="#2F6BFF"/><TextBlock Text="Einstellungen" Foreground="#718096" FontSize="12"/></StackPanel>
            </StackPanel>
            <Button Content="✕" Width="38" Height="38" HorizontalAlignment="Right" Click="Close_Click" ToolTip="Schließen"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="20" BorderBrush="#DCE4EF" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Browser" FontSize="11" FontWeight="Bold" Foreground="#98A5B8" Margin="10,6,0,8"/>
                    <Button x:Name="GeneralNav" Content="⌂   Allgemein" Style="{StaticResource NavButton}" Click="General_Click"/>
                    <Button Content="◈   Darstellung" Style="{StaticResource NavButton}" Click="Appearance_Click"/>
                    <Button Content="◉   Datenschutz &amp; Blocker" Style="{StaticResource NavButton}" Click="PrivacySettings_Click"/>
                    <Button Content="▣   Sicherheit" Style="{StaticResource NavButton}" Click="Security_Click"/>
                    <Button Content="ϟ   Leistung" Style="{StaticResource NavButton}" Click="Performance_Click"/>
                    <TextBlock Text="Hilfe" FontSize="11" FontWeight="Bold" Foreground="#98A5B8" Margin="10,22,0,8"/>
                    <Button Content="?   Wie du den Browser nutzt" Style="{StaticResource NavButton}" Click="Help_Click"/>
                    <Button Content="ⓘ   Über Orvian" Style="{StaticResource NavButton}" Click="About_Click"/>
                    <Border Margin="7,24,7,0" Padding="13" Background="#EDF4FF" CornerRadius="14">
                        <StackPanel><TextBlock Text="Orvian WOW" FontWeight="Bold" Foreground="#315EA8"/><TextBlock Text="Alles bleibt lokal auf diesem Gerät. Keine Orvian-Telemetrie." TextWrapping="Wrap" Foreground="#6B7B91" FontSize="11.5" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="20" BorderBrush="#DCE4EF" BorderThickness="1" Padding="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" Text="Allgemein" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="SectionSubtitle" Text="Startseite, Suche und grundlegende Browseroptionen." Foreground="#718096" FontSize="14" Margin="0,4,0,24"/>

                        <StackPanel x:Name="GeneralPanel">
                            <Border Padding="19" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="Startseite" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Diese Seite wird beim Start von Orvian geöffnet." Foreground="#718096" FontSize="12" Margin="0,4,0,12"/><TextBox Text="https://www.google.com/" Height="40" Padding="11,8"/></StackPanel>
                            </Border>
                            <Border Padding="19" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16">
                                <StackPanel><TextBlock Text="Suchmaschine" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Wähle, welche Suchmaschine bei Eingaben ohne URL verwendet wird." Foreground="#718096" FontSize="12" Margin="0,4,0,10"/><ComboBox SelectedIndex="0" Height="40"><ComboBoxItem>Google</ComboBoxItem><ComboBoxItem>DuckDuckGo</ComboBoxItem><ComboBoxItem>Bing</ComboBoxItem><ComboBoxItem>Brave Search</ComboBoxItem></ComboBox></StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <Border Padding="19" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="Design" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Hell, dunkel oder automatisch passend zu Windows." Foreground="#718096" FontSize="12" Margin="0,4,0,10"/><ComboBox Height="40" SelectedIndex="0"><ComboBoxItem>Hell</ComboBoxItem><ComboBoxItem>Dunkel</ComboBoxItem><ComboBoxItem>System</ComboBoxItem></ComboBox></StackPanel></Border>
                            <Border Padding="19" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16"><StackPanel><TextBlock Text="Animationen" FontSize="16" FontWeight="SemiBold"/><CheckBox Content="Flüssige UI-Animationen" IsChecked="True" Margin="0,12,0,8"/><CheckBox Content="Sanfte Tab-Übergänge" IsChecked="True"/></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                            <Border Padding="19" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16"><StackPanel><TextBlock Text="Orvian Shield" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Netzwerkbasierter Werbe- und Tracking-Schutz." Foreground="#718096" FontSize="12" Margin="0,4,0,12"/><CheckBox Content="Werbeblocker aktiv" IsChecked="True" Margin="0,7"/><CheckBox Content="Tracker-Blocker aktiv" IsChecked="True" Margin="0,7"/><CheckBox Content="Phishing-Schutz" IsChecked="True" Margin="0,7"/><CheckBox Content="Sichere Navigation" IsChecked="True" Margin="0,7"/><CheckBox Content="Keine Orvian-Telemetrie" IsChecked="True" Margin="0,7"/></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                            <Border Padding="20" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16"><StackPanel><TextBlock Text="Passwort-Tresor" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Gespeicherte Zugangsdaten werden mit Windows DPAPI für deinen Benutzer verschlüsselt." Foreground="#718096" TextWrapping="Wrap" Margin="0,5,0,16"/><Button Content="🔐  Passwort-Tresor öffnen" Style="{StaticResource CardButton}" Height="44" Click="OpenVault_Click"/></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                            <Border Padding="20" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16"><StackPanel><TextBlock Text="Leistung" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Unbenutzte Tabs automatisch pausieren" IsChecked="True" Margin="0,12,0,8"/><CheckBox Content="Cache intelligent verwalten" IsChecked="True" Margin="0,8"/><CheckBox Content="Hardwarebeschleunigung verwenden" IsChecked="True" Margin="0,8"/></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="HelpPanel" Visibility="Collapsed">
                            <Border Padding="20" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ctrl + T" FontWeight="Bold" Margin="0,7"/><TextBlock Text="Ctrl + W" FontWeight="Bold" Margin="0,7"/><TextBlock Text="Ctrl + L" FontWeight="Bold" Margin="0,7"/><TextBlock Text="Ctrl + R" FontWeight="Bold" Margin="0,7"/><TextBlock Text="Alt + C / D" FontWeight="Bold" Margin="0,7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Neuen Tab öffnen" Margin="0,7"/><TextBlock Text="Tab schließen" Margin="0,7"/><TextBlock Text="Adressleiste fokussieren" Margin="0,7"/><TextBlock Text="Aktuelle Seite neu laden" Margin="0,7"/><TextBlock Text="Browser sperren / entsperren" Margin="0,7"/></StackPanel></Grid></Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed"><TextBlock Text="Orvian Browser" FontSize="28" FontWeight="Bold"/><TextBlock Text="Open Source • Windows x64" Foreground="#718096" Margin="0,5,0,18"/><Border Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="16" Padding="20"><TextBlock Text="Orvian ist ein Chromium-basierter Windows-Browser mit Datenschutzfunktionen, eigenem Panda-Maskottchen und einer vollständig lokalen Datenhaltung." TextWrapping="Wrap" FontSize="14" Foreground="#506078"/></Border></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>