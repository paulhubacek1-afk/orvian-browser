<Window x:Class="Orvian.Browser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Einstellungen" Width="1080" Height="760" MinWidth="900" MinHeight="620"
        Background="#EEF3F9" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#F8FAFD" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="24" Padding="12" Effect="{StaticResource CardShadow}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,10,10,22">
                    <TextBlock Text="ORVIAN" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Browser-Einstellungen" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button Content="⌂   Allgemein" HorizontalContentAlignment="Left" Padding="15,12" Click="General_Click"/>
                    <Button Content="✦   Darstellung" HorizontalContentAlignment="Left" Padding="15,12" Click="Appearance_Click"/>
                    <Button Content="🛡   Datenschutz" HorizontalContentAlignment="Left" Padding="15,12" Click="PrivacySettings_Click"/>
                    <Button Content="🔐   Sicherheit" HorizontalContentAlignment="Left" Padding="15,12" Click="Security_Click"/>
                    <Button Content="⚡   Leistung" HorizontalContentAlignment="Left" Padding="15,12" Click="Performance_Click"/>
                    <Button Content="⌨   Tastatur &amp; Hilfe" HorizontalContentAlignment="Left" Padding="15,12" Click="Help_Click"/>
                    <Button Content="ⓘ   Über Orvian" HorizontalContentAlignment="Left" Padding="15,12" Click="About_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="8,18,8,6" Padding="14" Background="#EDF3FF" CornerRadius="16">
                    <StackPanel><TextBlock Text="ORVIAN 1.0.0" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Lokale Einstellungen • keine Browser-Telemetrie" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="16,0,0,0" Background="#FFFFFF" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="24" Padding="32" Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="Allgemein" FontSize="33" FontWeight="Bold"/>
                    <TextBlock x:Name="SectionSubtitle" Text="Startseite und grundlegende Browseroptionen." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,26" FontSize="14"/>

                    <StackPanel x:Name="GeneralPanel">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Startseite" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Welche Seite Orvian beim Start und mit dem Home-Symbol öffnet." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,13"/><TextBox Text="orvian://newtab" Height="42" Padding="12"/></StackPanel></Border>
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22"><StackPanel><TextBlock Text="Standardsuche" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Wähle die Suchmaschine für Begriffe, die keine URL sind." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><ComboBox Height="42" SelectedIndex="0"><ComboBoxItem>Google</ComboBoxItem><ComboBoxItem>DuckDuckGo</ComboBoxItem><ComboBoxItem>Bing</ComboBoxItem><ComboBoxItem>Brave Search</ComboBoxItem></ComboBox></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Darstellung" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Orvian hält die Oberfläche ruhig, klar und leicht." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/><ComboBox Height="42" SelectedIndex="2"><ComboBoxItem>Hell</ComboBoxItem><ComboBoxItem>Dunkel</ComboBoxItem><ComboBoxItem>System</ComboBoxItem></ComboBox></StackPanel></Border>
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22"><StackPanel><TextBlock Text="Animationen" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="Flüssige UI-Animationen" IsChecked="True" Margin="0,12,0,0"/><CheckBox Content="Panda-Micro-Animationen" IsChecked="True" Margin="0,9,0,0"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22"><StackPanel><TextBlock Text="Schutz" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="Werbeblocker" IsChecked="True" Margin="0,12,0,0"/><CheckBox Content="Tracker-Schutz" IsChecked="True" Margin="0,9,0,0"/><CheckBox Content="Filter automatisch aktualisieren" IsChecked="True" Margin="0,9,0,0"/><TextBlock Text="Orvian filtert Netzwerkressourcen mit schnellen Host- und Pfadregeln. Top-Level-Dokumente sowie lokale HTML-Dateien werden nicht vom Blocker abgefangen." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="24"><StackPanel><TextBlock Text="Passwort-Tresor" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Mehrere Website-Logins lokal verwalten. Die gespeicherten Einträge werden für den aktuellen Windows-Benutzer verschlüsselt abgelegt." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/><Button Content="🔐 Passwort-Tresor öffnen" Height="45" HorizontalAlignment="Left" Padding="18,9" Style="{StaticResource PrimaryButton}" Click="OpenVault_Click"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22"><StackPanel><TextBlock Text="Leistung" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="Hardwarebeschleunigung verwenden" IsChecked="True" Margin="0,12,0,0"/><CheckBox Content="Intelligentes Cache-Verhalten" IsChecked="True" Margin="0,9,0,0"/><CheckBox Content="Inaktive Tabs möglichst entlasten" IsChecked="True" Margin="0,9,0,0"/><TextBlock Text="Orvian nutzt WebView2 und vermeidet unnötige Arbeit im Browser-Chrome. Filterlisten werden im Hintergrund aktualisiert." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="HelpPanel" Visibility="Collapsed">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ctrl + T" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Ctrl + W" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Ctrl + L" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Ctrl + K" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Alt + C / D" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Neuen Tab öffnen" Margin="0,0,0,12"/><TextBlock Text="Aktiven Tab schließen" Margin="0,0,0,12"/><TextBlock Text="Adressleiste fokussieren" Margin="0,0,0,12"/><TextBlock Text="Command Palette" Margin="0,0,0,12"/><TextBlock Text="Browser sperren / entsperren"/></StackPanel></Grid></Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <Border Background="#F6F8FC" CornerRadius="18" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Orvian Browser" FontSize="31" FontWeight="Bold"/>
                                <TextBlock Text="Stable 1.0.0 • Windows x64" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,18"/>
                                <TextBlock Text="Orvian Browser ist ein moderner Desktop-Browser für Windows, der Microsoft Edge WebView2 als Chromium-basierte Webplattform nutzt und sie mit einer eigenständigen Browseroberfläche verbindet. Die Oberfläche stellt Tabs, Navigation, Verlauf, Lesezeichen, Downloads, lokale HTML-Dateien und eine klare Adressleiste bereit. Dazu kommen ein schneller Netzwerk-Filter für erkannte Werbe- und Tracker-Ressourcen, lokale Berechtigungsverwaltung, ein verschlüsselter Passwort-Tresor und eine automatische Update-Prüfung. Der technische Grundgedanke ist ähnlich zu modernen Chromium-Browsern: Eine etablierte Web-Engine übernimmt die Webplattform, während Browser-Chrome, Bedienoberfläche und zusätzliche Funktionen eigenständig umgesetzt werden. Orvian verbindet so vertraute Webkompatibilität mit einer eigenen Identität – inklusive des animierten Orvian-Pandas, der den Browser begleitet, ohne Webseiten oder die Browserleiste zu verdecken." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                                <Border Background="#EAF1FF" CornerRadius="15" Padding="15" Margin="0,20,0,0"><TextBlock Text="Engine: Microsoft Edge WebView2   •   Oberfläche: WPF   •   Ziel: Windows x64   •   Release: Stable 1.0.0" TextWrapping="Wrap" Foreground="#34557E" FontWeight="SemiBold"/></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
