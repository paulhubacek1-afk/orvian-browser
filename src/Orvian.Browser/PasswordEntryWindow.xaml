<Window x:Class="Orvian.Browser.PasswordEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zugangsdaten speichern" Width="500" Height="430" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Border Margin="18" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
        <StackPanel>
            <TextBlock Text="Neue Zugangsdaten" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Sie werden lokal verschlüsselt gespeichert." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
            <TextBlock Text="Website" FontWeight="SemiBold"/>
            <TextBox x:Name="SiteBox" Height="38" Padding="10,7" Margin="0,6,0,14"/>
            <TextBlock Text="Benutzername" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameBox" Height="38" Padding="10,7" Margin="0,6,0,14"/>
            <TextBlock Text="Passwort" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Height="38" Padding="10,7" Margin="0,6,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Width="95" Height="40" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Speichern" Width="105" Height="40" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>