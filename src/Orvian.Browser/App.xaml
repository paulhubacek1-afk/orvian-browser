<Application x:Class="Orvian.Browser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabBarBrush" Color="#F1F3F4"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DADCE0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1A73E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#202124"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6368"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D93025"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Application.Resources>
</Application>