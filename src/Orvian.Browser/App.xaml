<Application x:Class="Orvian.Browser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ══ Panda Dark Theme ══════════════════════════════════════ -->
        <SolidColorBrush x:Key="WindowBrush"       Color="#111111"/>
        <SolidColorBrush x:Key="TabBarBrush"        Color="#090909"/>
        <SolidColorBrush x:Key="ToolbarBrush"       Color="#151515"/>
        <SolidColorBrush x:Key="SurfaceBrush"       Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AccentBrush"        Color="#57C47A"/>  <!-- bamboo green -->
        <SolidColorBrush x:Key="AccentSoftBrush"    Color="#0E2A18"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#252525"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#EBEBEB"/>
        <SolidColorBrush x:Key="MutedBrush"         Color="#707070"/>
        <SolidColorBrush x:Key="DangerBrush"        Color="#E05569"/>
        <SolidColorBrush x:Key="SuccessBrush"       Color="#57C47A"/>

        <!-- Toolbar gradient (nearly flat dark) -->
        <LinearGradientBrush x:Key="ToolbarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#161616" Offset="0"/>
            <GradientStop Color="#131313" Offset="1"/>
        </LinearGradientBrush>

        <!-- Shadows -->
        <DropShadowEffect x:Key="CardShadow"  BlurRadius="32" ShadowDepth="6"  Direction="270" Opacity="0.65" Color="#000000"/>
        <DropShadowEffect x:Key="GreenGlow"   BlurRadius="18" ShadowDepth="0"  Opacity="0.40"  Color="#57C47A"/>

        <!-- Easings -->
        <CubicEase x:Key="EaseOut"   EasingMode="EaseOut"/>
        <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>

        <!-- ══ Base Styles ══════════════════════════════════════════ -->
        <Style TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,7"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="Cursor"           Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground"     Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderBrush"    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="CaretBrush"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground"     Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"     Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Padding"        Value="12,0"/>
        </Style>

        <!-- Toolbar icon button -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width"    Value="38"/>
            <Setter Property="Height"   Value="38"/>
            <Setter Property="Margin"   Value="2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333333"/>
                                <Setter TargetName="Root" Property="Opacity"    Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"  Value="#0A1A0F"/>
            <Setter Property="Padding"     Value="18,10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost pill button (secondary) -->
        <Style x:Key="GhostPill" TargetType="Button">
            <Setter Property="Height"           Value="38"/>
            <Setter Property="Padding"          Value="16,8"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Background"       Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="Root" Property="Opacity"    Value="0.78"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
