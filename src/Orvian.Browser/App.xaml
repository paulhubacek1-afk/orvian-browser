<Application x:Class="Orvian.Browser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#10131A"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171B24"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#98A1B2"/>
    </Application.Resources>
</Application>