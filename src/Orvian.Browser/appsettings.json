{
  "version": "0.1.0",
  "appearance": {
    "accent": "#7C5CFF",
    "background": "#10131A",
    "surface": "#171B24",
    "text": "#F4F6FA",
    "theme": "dark"
  },
  "privacy": {
    "adBlockEnabled": true,
    "trackerBlockEnabled": true,
    "phishingProtectionEnabled": true,
    "passwordLeakCheckEnabled": true,
    "telemetryEnabled": false
  },
  "shortcuts": {
    "lockBrowser": "Alt+C",
    "unlockBrowser": "Alt+D",
    "newTab": "Ctrl+T",
    "closeTab": "Ctrl+W",
    "reload": "Ctrl+R",
    "focusAddress": "Ctrl+L",
    "find": "Ctrl+F",
    "history": "Ctrl+H",
    "downloads": "Ctrl+J"
  },
  "blocking": {
    "defaultMode": "standard",
    "customRulesFile": "filters.txt",
    "allowlistFile": "allowlist.txt"
  }
}