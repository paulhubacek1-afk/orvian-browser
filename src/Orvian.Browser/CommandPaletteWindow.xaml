<Window x:Class="Orvian.Browser.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Command Palette" Width="720" Height="560" WindowStartupLocation="CenterOwner"
        Background="#F7F9FC" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Margin="12" Padding="16" CornerRadius="24" Background="White" BorderBrush="#D9E1EC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Grid.Row="0" FontSize="19" Padding="16,8" VerticalContentAlignment="Center" BorderBrush="#D6E0EB" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
            <ListBox x:Name="CommandList" Grid.Row="1" Margin="0,12,0,8" MouseDoubleClick="CommandList_MouseDoubleClick">
                <ListBox.ItemTemplate><DataTemplate><Border Padding="14,10" Margin="0,3" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6B778B" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="#7B8798" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="↑ ↓ auswählen   •   Enter ausführen   •   Esc schließen" Foreground="#748095" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
        </Grid>
    </Border>
</Window>
