<Window x:Class="Orvian.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Browser"
        Width="1500" Height="920"
        MinWidth="1050" MinHeight="680"
        Background="#F3F6FA"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Intro">
            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="Page" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.02" Duration="0:0:0.24"/>
        </Storyboard>
        <Storyboard x:Key="WelcomeIntro">
            <DoubleAnimation Storyboard.TargetName="WelcomeOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.42"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleY" From="0.90" To="1" Duration="0:0:0.42"/>
        </Storyboard>
        <Storyboard x:Key="WelcomeOutro">
            <DoubleAnimation Storyboard.TargetName="WelcomeOverlay" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.96" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleY" From="1" To="0.96" Duration="0:0:0.18"/>
        </Storyboard>
        <Storyboard x:Key="UpdateIntro">
            <DoubleAnimation Storyboard.TargetName="UpdateOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
        </Storyboard>
        <LinearGradientBrush x:Key="TopGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F2F6FB" Offset="0.68"/>
            <GradientStop Color="#E8F2FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F9FBFE" Offset="0"/>
            <GradientStop Color="#EEF4FA" Offset="0.6"/>
            <GradientStop Color="#E7F0FC" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="RoundAction" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EEF4FB"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#E8EEF6"/>
            <Setter Property="Foreground" Value="#53627A"/>
            <Setter Property="BorderBrush" Value="#D3DDE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="155"/>
            <Setter Property="MaxWidth" Value="235"/>
            <Setter Property="Margin" Value="2,5,5,3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F3F7FC"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillAction" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DFEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Chrome" Grid.Row="0" Background="#EAF0F6" BorderBrush="#D3DDE8" BorderThickness="0,0,0,1" Opacity="0">
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                        <TextBlock Text="O" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ORVIAN" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>
                <Button x:Name="NewTabButton" Grid.Column="2" Content="＋" Width="40" Height="36" Margin="5,0,0,0" FontSize="21" Click="NewTab_Click" ToolTip="Neuer Tab (Ctrl+T)" Style="{StaticResource PillAction}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource TopGradient}" BorderBrush="#D4DEE9" BorderThickness="0,0,0,1" Padding="10,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="202"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="‹" Style="{StaticResource RoundAction}" Click="Back_Click" ToolTip="Zurück"/>
                    <Button x:Name="ForwardButton" Content="›" Style="{StaticResource RoundAction}" Click="Forward_Click" ToolTip="Vorwärts"/>
                    <Button Content="↻" Style="{StaticResource RoundAction}" Click="Reload_Click" ToolTip="Neu laden"/>
                    <Button Content="⌂" Style="{StaticResource RoundAction}" Click="Home_Click" ToolTip="Startseite"/>
                </StackPanel>

                <Border Grid.Column="1" Height="48" CornerRadius="24" Background="#FFFFFF" BorderBrush="#C7D4E1" BorderThickness="1" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#EEF3F9" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⌕" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="AddressBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="15" Padding="0" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"/>
                        <Button Grid.Column="2" Content="☆" Width="32" Height="32" Padding="0" Foreground="{StaticResource MutedBrush}" Click="Bookmark_Click" ToolTip="Lesezeichen"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PrivacyButton" Content="🛡" Width="38" Height="38" Margin="2" Foreground="{StaticResource AccentBrush}" Click="Privacy_Click" ToolTip="Datenschutz-Center" Style="{StaticResource RoundAction}"/>
                    <Button Content="⋮" Width="38" Height="38" Margin="2" FontSize="20" Click="Menu_Click" ToolTip="Menü und Einstellungen" Style="{StaticResource RoundAction}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="Page" Grid.Row="2" Background="{StaticResource PageGradient}" Opacity="0">
            <ContentControl x:Name="BrowserHost"/>
            <Grid x:Name="PandaLayer" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="90"/>

            <Border x:Name="LockOverlay" Background="#DDECF5FA" Visibility="Collapsed">
                <Border Width="460" Padding="34" Background="#FFFFFF" BorderBrush="#D2DFEA" BorderThickness="1" CornerRadius="26" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Border Width="76" Height="76" CornerRadius="24" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="⌑" FontSize="35" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Orvian ist gesperrt" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,17,0,0"/>
                        <TextBlock Text="Alt + D zum Entsperren" Margin="0,7,0,22" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <PasswordBox x:Name="UnlockBox" Height="43" Padding="12"/>
                        <Button Content="Entsperren" Height="43" Margin="0,12,0,0" Click="Unlock_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="WelcomeOverlay" Background="#DCECF7FA" Visibility="Collapsed" Opacity="0">
                <Border Width="850" Padding="42" CornerRadius="30" Background="#FFFFFF" BorderBrush="#D3E1EE" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
                    <Border.RenderTransform><ScaleTransform x:Name="WelcomeCardScale" CenterX="425" CenterY="270"/></Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="158" Height="158" CornerRadius="52" Background="#EDF3FF" BorderBrush="#D4E3F2" BorderThickness="1">
                                <TextBlock Text="🐼" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ORVIAN BROWSER" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Willkommen bei Orvian" FontSize="36" FontWeight="Bold" Foreground="#172236"/>
                            <TextBlock Text="Schnell. Privat. Persönlich." FontSize="19" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,6,0,13"/>
                            <TextBlock Text="Orvian nutzt Microsoft Edge WebView2 für eine moderne Chromium-basierte Webplattform und verbindet sie mit einer eigenen Browseroberfläche, echten Tabs, lokaler Datenhaltung, Datenschutz- und Berechtigungsfunktionen, einem verschlüsselten Passwort-Tresor und automatischen Update-Prüfungen. Normale Websites und lokale HTML-Dateien bleiben dabei vollständig nutzbar." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,21"/>
                            <WrapPanel Margin="0,0,0,20">
                                <Border Background="#F1F5FB" CornerRadius="11" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="Mehrere Tabs" FontWeight="SemiBold" Foreground="#405675"/></Border>
                                <Border Background="#F1F5FB" CornerRadius="11" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="WebView2 / Chromium" FontWeight="SemiBold" Foreground="#405675"/></Border>
                                <Border Background="#F1F5FB" CornerRadius="11" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="HTML &amp; Web" FontWeight="SemiBold" Foreground="#405675"/></Border>
                                <Border Background="#F1F5FB" CornerRadius="11" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="Passwort-Tresor" FontWeight="SemiBold" Foreground="#405675"/></Border>
                            </WrapPanel>
                            <Button Content="Los geht's →" Height="46" Width="180" HorizontalAlignment="Left" Click="WelcomeContinue_Click" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <Border x:Name="UpdateOverlay" Background="#DCECF7FA" Visibility="Collapsed" Opacity="0">
                <Border Width="600" Padding="34" CornerRadius="27" Background="#FFFFFF" BorderBrush="#D2E1EE" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Border Width="66" Height="66" CornerRadius="21" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="↑" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ein neues Orvian-Update ist verfügbar" FontSize="28" FontWeight="Bold" Margin="0,15,0,0"/>
                        <TextBlock x:Name="UpdateText" Text="Eine neue Version wurde gefunden." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,23"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Später" Margin="0,0,8,0" Padding="16,8" Click="UpdateLater_Click"/>
                            <Button x:Name="UpdateNowButton" Content="Jetzt aktualisieren" Padding="16,8" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
