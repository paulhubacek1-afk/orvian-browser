<Window x:Class="Orvian.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Browser" Width="1500" Height="920" MinWidth="1100" MinHeight="700"
        Background="#EEF3F9" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Intro">
            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="Page" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.28"/>
        </Storyboard>
        <Storyboard x:Key="WelcomeIntro">
            <DoubleAnimation Storyboard.TargetName="WelcomeOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1" Duration="0:0:0.45" BeginTime="0:0:0.02"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleY" From="0.88" To="1" Duration="0:0:0.45" BeginTime="0:0:0.02"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="WelcomeOutro">
            <DoubleAnimation Storyboard.TargetName="WelcomeOverlay" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.96" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleY" From="1" To="0.96" Duration="0:0:0.22"/>
        </Storyboard>
        <Storyboard x:Key="UpdateIntro">
            <DoubleAnimation Storyboard.TargetName="UpdateOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <LinearGradientBrush x:Key="TopGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F2F7FD" Offset="0.58"/><GradientStop Color="#E5F1FF" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8FBFF" Offset="0"/><GradientStop Color="#EEF5FC" Offset="0.62"/><GradientStop Color="#E5F0FF" Offset="1"/></LinearGradientBrush>
        <Style x:Key="TabHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFD"/><Setter Property="Foreground" Value="#526078"/><Setter Property="BorderBrush" Value="#D7DFEB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,8,7,6"/><Setter Property="Padding" Value="11,0"/><Setter Property="Height" Value="39"/><Setter Property="MinWidth" Value="178"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EDF4FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircleAction" TargetType="Button">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D7E0EA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EEF4FB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TopAction" TargetType="Button">
            <Setter Property="Height" Value="35"/><Setter Property="Padding" Value="12,5"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D6E0EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="76"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="Chrome" Grid.Row="0" Background="#F4F7FB" BorderBrush="#D7E0EA" BorderThickness="0,0,0,1" Opacity="0">
            <Grid Margin="14,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource AccentBrush}" Effect="{StaticResource CardShadow}"><TextBlock Text="O" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="ORVIAN" FontSize="15" FontWeight="Bold"/><TextBlock Text="BROWSER" FontSize="9" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/></StackPanel></StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"><StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
                <Button x:Name="NewTabButton" Grid.Column="2" Content="＋" Width="42" Height="42" Margin="8,0,0,0" FontSize="21" Click="NewTab_Click" ToolTip="Neuer Tab (Ctrl+T)" Style="{StaticResource TopAction}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource TopGradient}" BorderBrush="#D7E0EA" BorderThickness="0,0,0,1" Padding="14,11">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackButton" Content="‹" Style="{StaticResource CircleAction}" FontSize="22" Click="Back_Click" ToolTip="Zurück"/><Button x:Name="ForwardButton" Content="›" Style="{StaticResource CircleAction}" FontSize="22" Click="Forward_Click" ToolTip="Vorwärts"/><Button Content="↻" Style="{StaticResource CircleAction}" FontSize="17" Click="Reload_Click" ToolTip="Neu laden"/><Button Content="⌂" Style="{StaticResource CircleAction}" FontSize="17" Click="Home_Click" ToolTip="Startseite"/></StackPanel>
                <Border Grid.Column="1" Height="50" CornerRadius="25" Background="#FFFFFF" BorderBrush="#C8D5E2" BorderThickness="1" Effect="{StaticResource CardShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="#EDF3FA" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⌕" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBox x:Name="AddressBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="15" Padding="0" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"/><Button Grid.Column="2" Content="☆" Width="31" Height="31" Padding="0" Foreground="{StaticResource MutedBrush}" Click="Bookmark_Click" ToolTip="Lesezeichen"/></Grid></Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="🛡" Width="42" Height="42" Margin="2" Foreground="{StaticResource AccentBrush}" Click="Privacy_Click" ToolTip="Datenschutz-Center"/><Button Content="⋮" Width="42" Height="42" Margin="2" FontSize="22" Click="Menu_Click" ToolTip="Menü und Einstellungen"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FAFCFF" BorderBrush="#D7E0EA" BorderThickness="0,0,0,1" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="PrivacyStats" Text="Orvian ist bereit" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="BlockerStats" Text="" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="13,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Website als App" Height="27" Padding="10,3" Margin="0,0,6,0" Click="InstallApp_Click" Style="{StaticResource TopAction}"/><Button Content="Passwort prüfen" Height="27" Padding="10,3" Click="CheckPassword_Click" Style="{StaticResource TopAction}"/></StackPanel></Grid></Border>

        <Grid x:Name="Page" Grid.Row="3" Background="{StaticResource PageGradient}" Opacity="0"><ContentControl x:Name="BrowserHost"/>
            <Border x:Name="LockOverlay" Background="#D9EAF3FA" Visibility="Collapsed"><Border Width="460" Padding="36" Background="#FFFFFF" BorderBrush="#D4E0EB" BorderThickness="1" CornerRadius="28" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}"><StackPanel><Border Width="78" Height="78" CornerRadius="25" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center"><TextBlock Text="⌑" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Orvian ist gesperrt" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="Alt + D zum Entsperren" Margin="0,7,0,22" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><PasswordBox x:Name="UnlockBox" Height="43" Padding="12"/><Button Content="Entsperren" Height="43" Margin="0,12,0,0" Click="Unlock_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border></Border>

            <Border x:Name="WelcomeOverlay" Background="#DDEAF4FC" Visibility="Collapsed" Opacity="0"><Border Width="820" Padding="44" CornerRadius="32" Background="#FFFFFF" BorderBrush="#D4E2EF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}"><Border.RenderTransform><ScaleTransform x:Name="WelcomeCardScale" CenterX="410" CenterY="280"/></Border.RenderTransform><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="150" Height="150" CornerRadius="54" Background="{StaticResource AccentSoftBrush}" Effect="{StaticResource CardShadow}"><Border Width="112" Height="112" CornerRadius="40" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="O" Foreground="White" FontSize="62" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Willkommen bei Orvian" FontSize="36" FontWeight="Bold" Foreground="#172236"/><TextBlock Text="Ein Browser mit eigener Identität." FontSize="19" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,7,0,13"/><TextBlock Text="Orvian verbindet eine Chromium-nahe Webplattform über Microsoft Edge WebView2 mit eigener Oberfläche, mehreren Tabs, einem lokal verschlüsselten Passwort-Tresor, Datenschutz- und Berechtigungsfunktionen, intelligentem Schutz vor Werbe- und Tracker-Ressourcen sowie automatischen Updates." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,21"/><WrapPanel Margin="0,0,0,21"><Border Background="#F2F6FC" CornerRadius="12" Padding="11,8" Margin="0,0,8,8"><TextBlock Text="Mehrere Tabs" Foreground="#385070" FontWeight="SemiBold"/></Border><Border Background="#F2F6FC" CornerRadius="12" Padding="11,8" Margin="0,0,8,8"><TextBlock Text="Privater Schutz" Foreground="#385070" FontWeight="SemiBold"/></Border><Border Background="#F2F6FC" CornerRadius="12" Padding="11,8" Margin="0,0,8,8"><TextBlock Text="Passwort-Tresor" Foreground="#385070" FontWeight="SemiBold"/></Border><Border Background="#F2F6FC" CornerRadius="12" Padding="11,8" Margin="0,0,8,8"><TextBlock Text="Automatische Updates" Foreground="#385070" FontWeight="SemiBold"/></Border></WrapPanel><Button Content="Los geht's →" Width="180" Height="47" HorizontalAlignment="Left" Click="WelcomeContinue_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Border></Border>

            <Border x:Name="UpdateOverlay" Background="#DDEAF4FC" Visibility="Collapsed" Opacity="0"><Border Width="600" Padding="34" CornerRadius="27" Background="#FFFFFF" BorderBrush="#D4E2EF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}"><StackPanel><Border Width="66" Height="66" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="↑" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Eine neue Orvian-Version ist da" FontSize="28" FontWeight="Bold" Margin="0,16,0,0"/><TextBlock x:Name="UpdateText" Text="Ein Update ist verfügbar." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Später" Margin="0,0,8,0" Padding="16,9" Click="UpdateLater_Click"/><Button x:Name="UpdateNowButton" Content="Jetzt aktualisieren" Padding="16,9" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click"/></StackPanel></StackPanel></Border></Border>
        </Grid>
    </Grid>
</Window>
