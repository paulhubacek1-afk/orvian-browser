<Window x:Class="Orvian.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Orvian Browser" Width="1400" Height="900" MinWidth="1000" MinHeight="650"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Chrome-like tab strip -->
        <Border Grid.Row="0" Background="{StaticResource TabBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="8,6,0,0" CornerRadius="9,9,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                    <Grid Margin="12,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="O" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Neuer Tab" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="×" Width="28" Height="28" Padding="0" FontSize="16" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="+" Width="38" Height="32" HorizontalAlignment="Left" Margin="8,4,0,0" FontSize="22" Foreground="{StaticResource MutedBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="−" Width="34" Height="30" Padding="0"/>
                    <Button Content="□" Width="34" Height="30" Padding="0"/>
                    <Button Content="×" Width="34" Height="30" Padding="0" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation + omnibox -->
        <Border Grid.Row="1" Background="{StaticResource ToolbarBrush}" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="‹" Click="Back_Click" ToolTip="Zurück"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Content="›" Click="Forward_Click" ToolTip="Vorwärts"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="↻" Click="Reload_Click" ToolTip="Neu laden"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="⌂" Click="Home_Click" ToolTip="Startseite"/>
                </StackPanel>
                <Border Grid.Column="1" Height="42" CornerRadius="21" Background="#F1F3F4" BorderBrush="#DADCE0" BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="AddressBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}"
                                 FontSize="15" VerticalContentAlignment="Center" Padding="0" KeyDown="AddressBox_KeyDown"/>
                        <Button Grid.Column="2" Content="☆" Width="30" Height="30" Padding="0" Foreground="{StaticResource MutedBrush}" ToolTip="Lesezeichen"/>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Content="⋮" Width="38" Height="38" FontSize="22" HorizontalAlignment="Right" Click="Menu_Click" ToolTip="Menü"/>
            </Grid>
        </Border>

        <!-- Lightweight info strip -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="PrivacyStats" Text="Orvian schützt diese Sitzung" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Passwort prüfen" Height="26" Padding="10,2" Click="CheckPassword_Click"/>
                <Button DockPanel.Dock="Right" Content="Website als App" Height="26" Padding="10,2" Margin="8,0,0,0" Click="InstallApp_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <wv2:WebView2 x:Name="BrowserView"/>
            <Border x:Name="LockOverlay" Background="#F9FFFFFF" Visibility="Collapsed">
                <Border Width="390" Padding="30" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Orvian ist gesperrt" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Alt+D zum Entsperren" Margin="0,8,0,20" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <PasswordBox x:Name="UnlockBox" Height="40" Padding="10"/>
                        <Button Content="Entsperren" Height="40" Margin="0,10,0,0" Click="Unlock_Click" Background="{StaticResource AccentBrush}" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>