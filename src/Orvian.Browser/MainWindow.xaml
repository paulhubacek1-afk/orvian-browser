<Window x:Class="Orvian.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian Browser"
        Width="1500" Height="920"
        MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ── Startup animation ────────────────────────────────── -->
        <Storyboard x:Key="Intro">
            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="Page"   Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.05" Duration="0:0:0.22"/>
        </Storyboard>

        <!-- ── Welcome overlay animations ───────────────────────── -->
        <Storyboard x:Key="WelcomeIntro">
            <DoubleAnimation Storyboard.TargetName="WelcomeOverlay"  Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        <Storyboard x:Key="WelcomeOutro">
            <DoubleAnimation Storyboard.TargetName="WelcomeOverlay"  Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.97" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeCardScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.97" Duration="0:0:0.15"/>
        </Storyboard>

        <!-- ── Creator overlay animations ───────────────────────── -->
        <Storyboard x:Key="CreatorIntro">
            <DoubleAnimation Storyboard.TargetName="CreatorOverlay"  Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20"/>
            <DoubleAnimation Storyboard.TargetName="CreatorCardScale" Storyboard.TargetProperty="ScaleX"
                             From="0.96" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="CreatorCardScale" Storyboard.TargetProperty="ScaleY"
                             From="0.96" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        <Storyboard x:Key="CreatorOutro">
            <DoubleAnimation Storyboard.TargetName="CreatorOverlay" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.13"/>
        </Storyboard>

        <!-- ── Update overlay animation ─────────────────────────── -->
        <Storyboard x:Key="UpdateIntro">
            <DoubleAnimation Storyboard.TargetName="UpdateOverlay" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18"/>
        </Storyboard>

        <!-- ── Button styles ─────────────────────────────────────── -->

        <!-- Icon button for toolbar/chrome -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width"    Value="38"/>
            <Setter Property="Height"   Value="38"/>
            <Setter Property="Margin"   Value="2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Browser tab button -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height"    Value="36"/>
            <Setter Property="MinWidth"  Value="130"/>
            <Setter Property="MaxWidth"  Value="220"/>
            <Setter Property="Margin"    Value="2,6,2,0"/>
            <Setter Property="Padding"   Value="10,0"/>
            <Setter Property="FontSize"  Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9,9,0,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round solid button (unlock, primary actions) -->
        <Style x:Key="RoundPrimary" TargetType="Button">
            <Setter Property="Height"     Value="44"/>
            <Setter Property="Padding"    Value="20,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0A1A0F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  ROOT GRID                                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>   <!-- Tab bar  -->
            <RowDefinition Height="56"/>   <!-- Toolbar  -->
            <RowDefinition Height="*"/>    <!-- Content  -->
        </Grid.RowDefinitions>

        <!-- ──────────────────────────────────────────────────────── -->
        <!--  ROW 0 — TAB BAR (Chrome)                                -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Border x:Name="Chrome"
                Grid.Row="0"
                Background="{StaticResource TabBarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Opacity="0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Panda logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                    <Canvas Width="32" Height="32" Margin="0,0,8,0">
                        <!-- Left ear -->
                        <Ellipse Width="12" Height="12" Fill="#EBEBEB" Canvas.Left="0"  Canvas.Top="0"/>
                        <!-- Right ear -->
                        <Ellipse Width="12" Height="12" Fill="#EBEBEB" Canvas.Left="20" Canvas.Top="0"/>
                        <!-- Left inner ear -->
                        <Ellipse Width="6"  Height="6"  Fill="#D08080" Canvas.Left="3"  Canvas.Top="3"/>
                        <!-- Right inner ear -->
                        <Ellipse Width="6"  Height="6"  Fill="#D08080" Canvas.Left="23" Canvas.Top="3"/>
                        <!-- Face -->
                        <Ellipse Width="28" Height="25" Fill="#F2F2F2" Canvas.Left="2"  Canvas.Top="7"/>
                        <!-- Left eye patch -->
                        <Ellipse Width="10" Height="8"  Fill="#1E1E1E" Canvas.Left="3"  Canvas.Top="11"/>
                        <!-- Right eye patch -->
                        <Ellipse Width="10" Height="8"  Fill="#1E1E1E" Canvas.Left="19" Canvas.Top="11"/>
                        <!-- Left eye white -->
                        <Ellipse Width="4.5" Height="4.5" Fill="White"  Canvas.Left="5.5" Canvas.Top="12.5"/>
                        <!-- Right eye white -->
                        <Ellipse Width="4.5" Height="4.5" Fill="White"  Canvas.Left="21"  Canvas.Top="12.5"/>
                        <!-- Left pupil -->
                        <Ellipse Width="2.5" Height="2.5" Fill="#111111" Canvas.Left="6.7" Canvas.Top="13.7"/>
                        <!-- Right pupil -->
                        <Ellipse Width="2.5" Height="2.5" Fill="#111111" Canvas.Left="22"  Canvas.Top="13.7"/>
                        <!-- Glint left -->
                        <Ellipse Width="1"   Height="1"   Fill="White"  Canvas.Left="7"    Canvas.Top="13.5"/>
                        <!-- Glint right -->
                        <Ellipse Width="1"   Height="1"   Fill="White"  Canvas.Left="22.3" Canvas.Top="13.5"/>
                        <!-- Nose -->
                        <Ellipse Width="5"   Height="3.5" Fill="#333333" Canvas.Left="13.5" Canvas.Top="22"/>
                    </Canvas>
                    <TextBlock Text="Orvian"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tab strip -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden"
                              Margin="6,0,6,0">
                    <StackPanel x:Name="TabStrip"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"/>
                </ScrollViewer>

                <!-- New Tab button -->
                <Button x:Name="NewTabButton"
                        Grid.Column="2"
                        Content="＋"
                        Width="36" Height="36"
                        FontSize="18"
                        Click="NewTab_Click"
                        ToolTip="Neuer Tab (Ctrl+T)"
                        Foreground="{StaticResource MutedBrush}"
                        Style="{StaticResource ChromeButton}"/>
            </Grid>
        </Border>

        <!-- ──────────────────────────────────────────────────────── -->
        <!--  ROW 1 — TOOLBAR                                         -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource ToolbarGradient}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton"    Content="‹"  Style="{StaticResource ChromeButton}" FontSize="22" Click="Back_Click"    ToolTip="Zurück (Alt+←)"/>
                    <Button x:Name="ForwardButton" Content="›"  Style="{StaticResource ChromeButton}" FontSize="22" Click="Forward_Click" ToolTip="Vorwärts (Alt+→)"/>
                    <Button                        Content="↻"  Style="{StaticResource ChromeButton}" FontSize="18" Click="Reload_Click"  ToolTip="Neu laden (F5)"/>
                    <Button                        Content="⌂"  Style="{StaticResource ChromeButton}" FontSize="18" Click="Home_Click"    ToolTip="Startseite"/>
                </StackPanel>

                <!-- Address bar -->
                <Border Grid.Column="2"
                        Height="40"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Effect="{StaticResource CardShadow}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"       Value="#1C1C1C"/>
                            <Setter Property="BorderBrush"      Value="#2E2E2E"/>
                            <Setter Property="BorderThickness"  Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search / lock icon -->
                        <Border Width="26" Height="26"
                                CornerRadius="13"
                                Background="{StaticResource AccentSoftBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⌕" FontSize="16"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- URL input -->
                        <TextBox x:Name="AddressBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="AddressBox_KeyDown"/>

                        <!-- Bookmark button -->
                        <Button Grid.Column="2"
                                Content="☆"
                                Width="30" Height="30"
                                Foreground="{StaticResource MutedBrush}"
                                FontSize="16"
                                Click="Bookmark_Click"
                                ToolTip="Lesezeichen"/>
                    </Grid>
                </Border>

                <!-- Right action buttons -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Button x:Name="PrivacyButton"
                            Content="◈"
                            Style="{StaticResource ChromeButton}"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="20"
                            Click="Privacy_Click"
                            ToolTip="Datenschutz-Center"/>
                    <Button Content="⋮"
                            Style="{StaticResource ChromeButton}"
                            FontSize="22"
                            Click="Menu_Click"
                            ToolTip="Menü"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ──────────────────────────────────────────────────────── -->
        <!--  ROW 2 — PAGE CONTENT                                    -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Grid x:Name="Page" Grid.Row="2"
              Background="{StaticResource WindowBrush}"
              Opacity="0">

            <!-- WebView2 host -->
            <ContentControl x:Name="BrowserHost"/>

            <!-- Panda mascot layer -->
            <Grid x:Name="PandaLayer"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Panel.ZIndex="50"/>

            <!-- ── LOCK OVERLAY ─────────────────────────────────── -->
            <Border x:Name="LockOverlay"
                    Background="#DD0A0A0A"
                    Visibility="Collapsed"
                    Panel.ZIndex="100">
                <Border Width="420" Padding="36"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Panda lock icon -->
                        <Canvas Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Ellipse Width="18" Height="18" Fill="#E8E8E8" Canvas.Left="4"  Canvas.Top="0"/>
                            <Ellipse Width="18" Height="18" Fill="#E8E8E8" Canvas.Left="42" Canvas.Top="0"/>
                            <Ellipse Width="10" Height="10" Fill="#C08080" Canvas.Left="8"  Canvas.Top="4"/>
                            <Ellipse Width="10" Height="10" Fill="#C08080" Canvas.Left="46" Canvas.Top="4"/>
                            <Ellipse Width="52" Height="46" Fill="#F2F2F2" Canvas.Left="6"  Canvas.Top="14"/>
                            <Ellipse Width="17" Height="14" Fill="#1A1A1A" Canvas.Left="7"  Canvas.Top="22"/>
                            <Ellipse Width="17" Height="14" Fill="#1A1A1A" Canvas.Left="40" Canvas.Top="22"/>
                            <Ellipse Width="8"  Height="8"  Fill="White"   Canvas.Left="11" Canvas.Top="25"/>
                            <Ellipse Width="8"  Height="8"  Fill="White"   Canvas.Left="44" Canvas.Top="25"/>
                            <Ellipse Width="5"  Height="5"  Fill="#111"    Canvas.Left="13" Canvas.Top="27"/>
                            <Ellipse Width="5"  Height="5"  Fill="#111"    Canvas.Left="46" Canvas.Top="27"/>
                            <Ellipse Width="10" Height="7"  Fill="#333"    Canvas.Left="27" Canvas.Top="45"/>
                        </Canvas>

                        <TextBlock Text="Orvian ist gesperrt"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Drücke Alt+D oder gib dein Passwort ein"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,20"/>
                        <PasswordBox x:Name="UnlockBox"
                                     Height="44"
                                     Padding="16,0"
                                     Background="#252525"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextBrush}"/>
                        <Button Content="Entsperren"
                                Margin="0,14,0,0"
                                Click="Unlock_Click"
                                Style="{StaticResource RoundPrimary}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ── WELCOME OVERLAY ──────────────────────────────── -->
            <Border x:Name="WelcomeOverlay"
                    Background="#E0080808"
                    Visibility="Collapsed"
                    Opacity="0"
                    Panel.ZIndex="90">
                <Border Width="860" MaxWidth="920" Padding="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource CardShadow}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="WelcomeCardScale" CenterX="430" CenterY="250"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left panda panel -->
                        <Border Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="28,0,0,28"
                                Padding="24">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Big panda face -->
                                <Canvas Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Ellipse Width="44" Height="44" Fill="#E8E8E8" Canvas.Left="4"  Canvas.Top="2"/>
                                    <Ellipse Width="44" Height="44" Fill="#E8E8E8" Canvas.Left="72" Canvas.Top="2"/>
                                    <Ellipse Width="26" Height="26" Fill="#C08080" Canvas.Left="13" Canvas.Top="11"/>
                                    <Ellipse Width="26" Height="26" Fill="#C08080" Canvas.Left="81" Canvas.Top="11"/>
                                    <Ellipse Width="104" Height="90" Fill="#F5F5F5" Canvas.Left="8"  Canvas.Top="28"/>
                                    <Ellipse Width="36" Height="30" Fill="#1A1A1A" Canvas.Left="12" Canvas.Top="44"/>
                                    <Ellipse Width="36" Height="30" Fill="#1A1A1A" Canvas.Left="72" Canvas.Top="44"/>
                                    <Ellipse Width="16" Height="16" Fill="White"   Canvas.Left="20" Canvas.Top="50"/>
                                    <Ellipse Width="16" Height="16" Fill="White"   Canvas.Left="80" Canvas.Top="50"/>
                                    <Ellipse Width="9"  Height="9"  Fill="#111"    Canvas.Left="24" Canvas.Top="54"/>
                                    <Ellipse Width="9"  Height="9"  Fill="#111"    Canvas.Left="84" Canvas.Top="54"/>
                                    <Ellipse Width="3"  Height="3"  Fill="White"   Canvas.Left="26" Canvas.Top="53"/>
                                    <Ellipse Width="3"  Height="3"  Fill="White"   Canvas.Left="86" Canvas.Top="53"/>
                                    <Ellipse Width="20" Height="14" Fill="#333"    Canvas.Left="50" Canvas.Top="90"/>
                                    <!-- Blush -->
                                    <Ellipse Width="16" Height="9"  Fill="#E89090" Opacity="0.5" Canvas.Left="6"  Canvas.Top="75"/>
                                    <Ellipse Width="16" Height="9"  Fill="#E89090" Opacity="0.5" Canvas.Left="98" Canvas.Top="75"/>
                                </Canvas>
                                <TextBlock Text="Orvian"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Open Source Browser"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right content panel -->
                        <StackPanel Grid.Column="1" Padding="36,32" VerticalAlignment="Center">
                            <TextBlock Text="Willkommen bei Orvian 🎉"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"
                                       LineHeight="22"
                                       Margin="0,0,0,24"
                                       Text="Schnell. Privat. Dein Browser. Orvian basiert auf Chromium und unterstützt alle Chrome-Erweiterungen — mit einem Panda an deiner Seite."/>

                            <StackPanel Margin="0,0,0,28" Spacing="10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Integrierter Ad- und Tracker-Blocker" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="⊕" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Chrome-Erweiterungen nativ laden" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="🔒" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Passwort-Vault für sichere Zugangsdaten" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Content="Jetzt loslegen →"
                                    Style="{StaticResource RoundPrimary}"
                                    HorizontalAlignment="Left"
                                    Click="WelcomeClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ── CREATOR OVERLAY ──────────────────────────────── -->
            <Border x:Name="CreatorOverlay"
                    Background="#DF080808"
                    Visibility="Collapsed"
                    Opacity="0"
                    Panel.ZIndex="90">
                <Border Width="480" Padding="36"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource CardShadow}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CreatorCardScale" CenterX="240" CenterY="200"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <!-- Mini panda logo -->
                        <Canvas Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Width="22" Height="22" Fill="#E8E8E8" Canvas.Left="2"  Canvas.Top="0"/>
                            <Ellipse Width="22" Height="22" Fill="#E8E8E8" Canvas.Left="36" Canvas.Top="0"/>
                            <Ellipse Width="12" Height="12" Fill="#C08080" Canvas.Left="7"  Canvas.Top="5"/>
                            <Ellipse Width="12" Height="12" Fill="#C08080" Canvas.Left="41" Canvas.Top="5"/>
                            <Ellipse Width="52" Height="44" Fill="#F2F2F2" Canvas.Left="4"  Canvas.Top="14"/>
                            <Ellipse Width="18" Height="14" Fill="#1A1A1A" Canvas.Left="5"  Canvas.Top="22"/>
                            <Ellipse Width="18" Height="14" Fill="#1A1A1A" Canvas.Left="37" Canvas.Top="22"/>
                            <Ellipse Width="8"  Height="8"  Fill="White"   Canvas.Left="9"  Canvas.Top="25"/>
                            <Ellipse Width="8"  Height="8"  Fill="White"   Canvas.Left="41" Canvas.Top="25"/>
                            <Ellipse Width="4.5" Height="4.5" Fill="#111"  Canvas.Left="11" Canvas.Top="27"/>
                            <Ellipse Width="4.5" Height="4.5" Fill="#111"  Canvas.Left="43" Canvas.Top="27"/>
                            <Ellipse Width="10" Height="7"  Fill="#333"    Canvas.Left="25" Canvas.Top="44"/>
                        </Canvas>

                        <TextBlock Text="Orvian Browser"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CreatorVersionText"
                                   Text="Open Source · Chromium-powered"
                                   FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,20"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                        <StackPanel Spacing="8" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Entwickelt von  " Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                <TextBlock Text="paulhubacek1-afk" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="https://github.com/paulhubacek1-afk/orvian-browser"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="Schließen"
                                Style="{StaticResource RoundPrimary}"
                                HorizontalAlignment="Center"
                                Click="CreatorClose_Click"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ── UPDATE OVERLAY ───────────────────────────────── -->
            <Border x:Name="UpdateOverlay"
                    Visibility="Collapsed"
                    Opacity="0"
                    VerticalAlignment="Top"
                    Panel.ZIndex="80">
                <Border Margin="12,12,12,0"
                        Background="#1A2E1A"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,10"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎋 " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdateMessageText"
                                       Text="Ein Update ist verfügbar!"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="UpdateNowButton"
                                    Content="Jetzt aktualisieren"
                                    Style="{StaticResource RoundPrimary}"
                                    Height="34" Padding="14,0"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Click="UpdateNow_Click"/>
                            <Button Content="✕"
                                    Style="{StaticResource ChromeButton}"
                                    Foreground="{StaticResource MutedBrush}"
                                    Width="30" Height="30"
                                    Click="UpdateDismiss_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

        </Grid>
        <!-- end Page -->

    </Grid>
</Window>
