<Window x:Class="Orvian.Browser.UpdateWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orvian – Update"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F9FD"
        ShowInTaskbar="False">
    <Window.Resources>
        <Storyboard x:Key="Intro">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.78" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.18"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.78" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.18"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.30"/>
            <DoubleAnimation Storyboard.TargetName="PandaScale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1" Duration="0:0:0.5" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PandaScale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1" Duration="0:0:0.5" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PandaRotate" Storyboard.TargetProperty="Angle" From="-5" To="5" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="2x" BeginTime="0:0:0.62"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="Card" Margin="32" CornerRadius="28" Background="White" BorderBrush="#D9E6F2" BorderThickness="1" Opacity="0" Padding="34">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" CenterX="450" CenterY="278"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PandaScale" ScaleX="0.5" ScaleY="0.5" CenterX="110" CenterY="110"/>
                            <RotateTransform x:Name="PandaRotate" Angle="0" CenterX="110" CenterY="110"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Canvas Width="220" Height="220">
                        <Ellipse Width="76" Height="76" Fill="#20242B" Canvas.Left="12" Canvas.Top="8"/>
                        <Ellipse Width="76" Height="76" Fill="#20242B" Canvas.Left="132" Canvas.Top="8"/>
                        <Ellipse Width="178" Height="158" Fill="#20242B" Canvas.Left="21" Canvas.Top="38"/>
                        <Ellipse Width="158" Height="136" Fill="White" Canvas.Left="31" Canvas.Top="50"/>
                        <Ellipse Width="55" Height="70" Fill="#20242B" Canvas.Left="42" Canvas.Top="66" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-23"/></Ellipse.RenderTransform></Ellipse>
                        <Ellipse Width="55" Height="70" Fill="#20242B" Canvas.Left="123" Canvas.Top="66" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="23"/></Ellipse.RenderTransform></Ellipse>
                        <Ellipse Width="16" Height="22" Fill="White" Canvas.Left="59" Canvas.Top="89"/>
                        <Ellipse Width="16" Height="22" Fill="White" Canvas.Left="145" Canvas.Top="89"/>
                        <Ellipse Width="8" Height="12" Fill="#20242B" Canvas.Left="63" Canvas.Top="95"/>
                        <Ellipse Width="8" Height="12" Fill="#20242B" Canvas.Left="149" Canvas.Top="95"/>
                        <Ellipse Width="22" Height="16" Fill="#20242B" Canvas.Left="98" Canvas.Top="116"/>
                        <Ellipse Width="15" Height="8" Fill="#FFB0B8" Canvas.Left="45" Canvas.Top="135" Opacity="0.72"/>
                        <Ellipse Width="15" Height="8" Fill="#FFB0B8" Canvas.Left="160" Canvas.Top="135" Opacity="0.72"/>
                    </Canvas>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,8,0">
                    <TextBlock Text="Willkommen beim neuen Update!" FontSize="34" FontWeight="Bold" Foreground="#182332" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VersionText" Text="Orvian 1.0.0 ist bereit." FontSize="18" Foreground="#1A73E8" FontWeight="SemiBold" Margin="0,8,0,16"/>
                    <TextBlock Text="Eine stabile Orvian-Version mit sauberer Web-Navigation und den wichtigsten Browser-Grundfunktionen." FontSize="14" Foreground="#687587" Margin="0,0,0,20" TextWrapping="Wrap"/>

                    <Border Background="#F3F8FD" CornerRadius="16" Padding="16" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="Enthalten" FontSize="15" FontWeight="Bold" Foreground="#233043" Margin="0,0,0,10"/>
                            <TextBlock Text="🐼 Animiertes Panda-Maskottchen" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                            <TextBlock Text="⌕ Command Palette &amp; interne Orvian-Seiten" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                            <TextBlock Text="📚 Verlauf &amp; Lesezeichen" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                            <TextBlock Text="📥 Download-Übersicht" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                            <TextBlock Text="🛡 Datenschutz &amp; Berechtigungen" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                            <TextBlock Text="🌐 HTML-Dateien, data: und normale Websites" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                            <TextBlock Text="↗ Echte neue Tabs für neue Fenster/Links" FontSize="13.5" Foreground="#334155" Margin="0,3"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Los geht's 🚀" Width="150" Height="45" Background="#1A73E8" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="Continue_Click"/>
                        <Button Content="Update-Details" Width="125" Height="45" Margin="10,0,0,0" Background="#EEF5FF" Foreground="#1A73E8" BorderThickness="0" Click="Details_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
